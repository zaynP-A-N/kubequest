[kube_control_plane]
kube-1 ansible_host="NAT IP" ansible_user="username of vm" internal_ip="Host-Only IP"

[kube_workers]
kube-2 ansible_host="NAT IP" ansible_user="username of vm" internal_ip="Host-Only IP"

[ingress]
ingress ansible_host="NAT IP" ansible_user="username of vm" internal_ip="Host-Only IP"

[monitoring]
monitoring ansible_host="NAT IP" ansible_user="username of vm" internal_ip="Host-Only IP"

