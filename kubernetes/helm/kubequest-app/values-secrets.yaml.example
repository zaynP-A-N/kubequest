# =============================================================================
# values-secrets.yaml.example — KubeQuest Group-53
#
# TEMPLATE pour les valeurs sensibles du chart kubequest-app.
#
# INSTRUCTIONS :
#   1. Copier ce fichier :
#        cp values-secrets.yaml.example values-secrets.yaml
#   2. Remplir les valeurs avec les vrais credentials
#   3. values-secrets.yaml est dans .gitignore → ne sera jamais commité
#
# EN PRODUCTION → Utiliser Sealed Secrets (voir kubernetes/sealed-secrets/)
# =============================================================================

app:
  env:
    # Clé de chiffrement Laravel (générer avec : php artisan key:generate --show)
    appKey: "base64:CHANGE_ME_GENERATE_WITH_php_artisan_key:generate"

mysql:
  credentials:
    # Nom de la base de données
    database: CHANGE_ME_database_name

    # Utilisateur MySQL (pas root)
    user: CHANGE_ME_db_user

    # Mot de passe de l'utilisateur MySQL (min 16 caractères en prod)
    password: CHANGE_ME_strong_password_here

    # Mot de passe root MySQL (différent du mot de passe user)
    rootPassword: CHANGE_ME_different_root_password_here
