# =============================================================================
# values-secrets.yaml.example — Template pour les secrets
# COPIE ce fichier : cp values-secrets.yaml.example values-secrets.yaml
# Remplis les valeurs puis ne jamais commit values-secrets.yaml (voir .gitignore)
# =============================================================================

app:
  env:
    appKey: "base64:GENERE_AVEC_php_artisan_key:generate_--show"

mysql:
  credentials:
    database: kubequest_db
    user: kubequest_user
    password: "TON_MOT_DE_PASSE_ICI"
    rootPassword: "TON_ROOT_PASSWORD_ICI"
